# HomePilot — Environment Variables
# ────────────────────────────────────────────────────────────────────────
# Zero-secrets boot: the ONLY secret in this file is HP_VAULT_PASSPHRASE.
# All other secrets (HP_SECRET_KEY, HP_ADMIN_SECRET, PVE_API_TOKEN, etc.)
# are stored in the encrypted vault and read at runtime.
#
# Run `hp init` to bootstrap your environment. It will:
#   1. Generate HP_VAULT_PASSPHRASE and write it to .env
#   2. Generate HP_SECRET_KEY and HP_ADMIN_SECRET and store them in vault
#   3. Optionally store PVE_API_TOKEN in vault
#
# After init, .env contains ZERO application secrets — only the vault
# passphrase needed to unlock the vault at boot.
# ────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════
#  Docker
# ══════════════════════════════════════════════════════════════════════════
HP_IMAGE_TAG=2.2.5             # ghcr.io/mtclab/homepilot-core-public image tag

# ══════════════════════════════════════════════════════════════════════════
#  HomePilot v2 Core
# ══════════════════════════════════════════════════════════════════════════
HP_DATA_DIR=/home/homepilot/.hp
HP_ARTIFACTS_DIR=/home/homepilot/.hp/artifacts
HP_ARTIFACTS_REMOTE=            # Git remote for artifact backup
HP_ARTIFACTS_SSH_KEY=          # Absolute path to SSH key for artifacts remote
HP_LOG_LEVEL=info               # debug | info | warning | error
HP_RATE_LIMIT=60                # Requests per minute per IP

# ── Vault (bootstrap secret — the ONLY secret in .env) ──────────────────
HP_VAULT_PASSPHRASE=            # Required. Run `hp init` to generate.
HP_VAULT_DIR=                   # Defaults to <HP_DATA_DIR>/vault
# HP_VAULT_PASSPHRASE_FILE=    # Docker secrets: mount file instead of env var

# ── Secrets stored in vault (NOT in .env) ───────────────────────────────
# The following are auto-stored in vault by `hp init`:
#   secret-key      — JWT signing key (equivalent to HP_SECRET_KEY)
#   admin-secret    — Admin API auth (equivalent to HP_ADMIN_SECRET)
#   pve-token       — Proxmox API token (equivalent to PVE_API_TOKEN)
#
# Override vault with env vars only for dev/debug:
# HP_SECRET_KEY=                 # Override: JWT signing key (use vault instead)
# HP_SECRET_KEY_FILE=            # Override: file-based JWT key
# HP_ADMIN_SECRET=               # Override: admin auth (use vault instead)
# PVE_API_TOKEN=                 # Override: Proxmox token (use vault instead)

# ── Daemon ──────────────────────────────────────────────────────────────
HP_DAEMON_HOST=0.0.0.0
HP_DAEMON_PORT=8000

# ── Proxmox ─────────────────────────────────────────────────────────────
HP_PROXMOX_HOST=               # PVE hostname/IP (e.g. pve.example.local)
HP_PROXMOX_PORT=8006
HP_PROXMOX_VERIFY_SSL=false

# ── Automation ──────────────────────────────────────────────────────────
HP_AUTO_APPROVE_NONMUTATING=true
HP_AUTO_APPLY_ON_APPROVE=true

# ── Embedding Service ───────────────────────────────────────────────────
HP_EMBEDDING_SERVICE_URL=http://llm-embed:8081/v1/embeddings
HP_EMBEDDING_MODEL=bge-m3
HP_EMBEDDING_FALLBACK_URL=http://localhost:11434/api/embeddings
HP_EMBEDDING_FALLBACK_MODEL=nomic-embed-text

# ── MCP ─────────────────────────────────────────────────────────────────
HP_MCP_TOKEN=                  # Optional. Bearer token for MCP transport

# ── Events / Webhooks ───────────────────────────────────────────────────
HP_EVENTS_WEBHOOK_URL=http://n8n:5678/webhook/artifact-proposed
# HP_EVENTS_WEBHOOK_SECRET=    # Stored in vault as webhook-secret

# ══════════════════════════════════════════════════════════════════════════
#  Jump Server (SSH relay)
# ══════════════════════════════════════════════════════════════════════════
HP_JUMP_ENABLED=false
HP_JUMP_SERVER_HOST=jumpserver
HP_JUMP_SERVER_PORT=50051
# JUMPSERVER_AUTH_TOKEN=        # Stored in vault as jumpserver-token
JUMPSERVER_PORT=50051
RELAY_HOST=0.0.0.0
RELAY_PORT=50051
SSH_KEY_PATH=/root/.ssh/id_ed25519
JUMPSERVER_LOG_DIR=/var/log/jumpserver
JUMPSERVER_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
PVE_NODE_NAMES=                 # Comma-separated PVE node hostnames
JUMPSERVER_TLS=false
JUMPSERVER_TLS_CERT=
JUMPSERVER_TLS_KEY=
JUMPSERVER_TLS_CA=

# ══════════════════════════════════════════════════════════════════════════
#  LLM (llama.cpp)
# ══════════════════════════════════════════════════════════════════════════
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_PARALLEL=4
GGUF_MODEL_FILENAME=Qwen3-14B-Q8_0.gguf

# ══════════════════════════════════════════════════════════════════════════
#  n8n
# ══════════════════════════════════════════════════════════════════════════
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=            # openssl rand -hex 32
# HP_N8N_API_KEY=              # Stored in vault as n8n-key

# HP_MCP_URL is set automatically in docker-compose (http://backend:8000/mcp)
# n8n credential store should hold: HP_MCP_TOKEN, HP_MCP_TOKEN_RW, HP_WEBHOOK_SECRET
# See agent/.env.example for full list of n8n credential vars.

# ══════════════════════════════════════════════════════════════════════════
#  SearXNG
# ══════════════════════════════════════════════════════════════════════════
SEARXNG_SECRET_KEY=            # openssl rand -hex 32

# ══════════════════════════════════════════════════════════════════════════
#  Radicale (CalDAV)
# ══════════════════════════════════════════════════════════════════════════
# To create htpasswd: htpasswd -Bbc agent/radicale/htpasswd admin <password>
RADICALE_USER=admin
RADICALE_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
#  Timezone
# ══════════════════════════════════════════════════════════════════════════
TZ=Etc/UTC