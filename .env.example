# HomePilot — Environment Variables
# ────────────────────────────────────────────────────────────────────────
# Nothing in this file has to be edited for a normal install. Copy it, run
# `docker compose up -d`, then open the web UI from the same network and
# claim the instance — that screen creates the admin credential and takes
# the Proxmox address and token. Every variable here is an OVERRIDE.
#
# Zero-secrets boot: no application secret belongs in this file. The vault
# passphrase generates itself on first boot, and every other secret
# (admin-secret, PVE_API_TOKEN, webhook-secret, ...) lives in the encrypted
# vault and is read at runtime.
#
# `hp init` still exists for SCRIPTED installs (it writes .env and mints a
# token non-interactively). It is not needed for a normal install, and the
# claim path closes the moment it — or anything else — mints an admin token.
# ────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════
#  Docker
# ══════════════════════════════════════════════════════════════════════════
HP_IMAGE_TAG=3.6.18

# ══════════════════════════════════════════════════════════════════════════
#  HomePilot v2 Core
# ══════════════════════════════════════════════════════════════════════════
HP_ENV=                         # Set to `production` to refuse an auto-generated vault passphrase
HP_DATA_DIR=/home/homepilot/.hp
HP_ARTIFACTS_DIR=/home/homepilot/.hp/artifacts
HP_ARTIFACTS_REMOTE=            # Git remote for artifact backup
HP_ARTIFACTS_SSH_KEY=          # Absolute path to SSH key for artifacts remote
HP_ALLOWED_HTTP_DOMAINS=        # Comma-separated allowlist for http_call_read (SSRF guard)
HP_LOG_LEVEL=info               # debug | info | warning | error
HP_RATE_LIMIT=60                # Requests per minute per IP (read from env, not Settings)

# ── HTTP / security ──────────────────────────────────────────────────────
# Default CORS origins are the four localhost dev origins below. Set to your
# UI origin(s) in production; never leave a wildcard on an authenticated API.
HP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
HP_COOKIE_SECURE=true           # Set false only for plain-HTTP local dev
HP_TRUSTED_PROXIES=             # Comma-separated proxy IPs trusted for X-Forwarded-For

# ── Native metrics (ADR-004 S5) ──────────────────────────────────────────
# Agents report system metrics over the hub connection; HomePilot stores them.
# Raw samples only - there is no rollup, so retention is what bounds the table.
HP_METRICS_RETENTION_DAYS=7            # Raw samples older than this are pruned

# How long operational HISTORY is kept: audit_log, agent_audit, finished tasks
# and webhook deliveries. Artifacts are NEVER pruned - they are the record of
# intent. Longer than the metrics window because an audit trail answers "who
# changed this, and when" months later.
HP_RETENTION_DAYS=90
HP_RETENTION_INTERVAL_SECONDS=21600    # How often the retention sweep runs
HP_DB_INTEGRITY_INTERVAL_SECONDS=21600 # How often PRAGMA quick_check runs against the DB file (0 = off)

# ── Artifact archive (off-box copy of the artifact store) ────────────────
# Set a git remote (e.g. a private GitHub repo with a write deploy key) and
# HomePilot pushes the artifact store there on a schedule. The Settings panel
# reports the LAST PUSH's real outcome, not just "a remote is set".
# HP_ARTIFACTS_REMOTE=git@github.com:you/homepilot-archive.git
# HP_ARTIFACTS_SSH_KEY=/home/homepilot/.hp/archive_key
HP_ARTIFACTS_PUSH_INTERVAL_SECONDS=3600
HP_METRICS_PRUNE_INTERVAL_SECONDS=3600 # How often the pruner runs
HP_METRICS_ALERT_INTERVAL_SECONDS=60   # How often alert rules are evaluated

# ── Invite portal (/invite/*, public mTLS vhost) ─────────────────────────
# ALL FOUR of the first four must be set or every /invite route returns 503.
# See docs/portal.md for the nginx location block.
HP_PORTAL_CN_HEADER=ssl-client-subject-dn   # Header the proxy sets with the client-cert subject DN
HP_PORTAL_VERIFY_HEADER=ssl-client-verify   # Header that must equal SUCCESS
HP_PORTAL_TRUSTED_PROXY=        # Address/CIDR(s) portal requests must come from
HP_PORTAL_PROXY_SECRET=         # Shared secret the proxy sets in X-Hp-Portal-Secret
HP_PORTAL_BASE_URL=             # Public origin, used only to print complete invite URLs

# ── Reconcilers ──────────────────────────────────────────────────────────
HP_INVENTORY_INTERVAL_SECONDS=300
HP_DRIFT_INTERVAL_SECONDS=1800
HP_AUTO_APPLY_ENABLED=false
HP_AUTO_APPLY_INTERVAL_SECONDS=300

# ── Vault (bootstrap secret — the ONLY secret in .env) ──────────────────
# Leave the passphrase blank. The backend generates one on first boot and
# persists it to <HP_DATA_DIR>/.vault_passphrase (0600), so the vault is
# unlocked without an operator choosing anything. Set HP_VAULT_PASSPHRASE only
# to bring an existing vault's passphrase in from outside.
HP_VAULT_AUTO_INIT=             # Set 0 to refuse to generate one (vault stays disabled)
HP_VAULT_PASSPHRASE=            # Override: an existing passphrase
HP_VAULT_DIR=                   # Defaults to <HP_DATA_DIR>/vault
# HP_VAULT_PASSPHRASE_FILE=    # Docker secrets: mount file instead of env var

# ── Secrets stored in vault (NOT in .env) ───────────────────────────────
# The following are stored in the vault (by the first-run claim, the Settings
# page, `hp vault set`, or `hp init`):
#   admin-secret    — Admin API auth (equivalent to HP_ADMIN_SECRET)
#   pve-token       — Proxmox read API token (equivalent to PVE_API_TOKEN)
#   pve-write-token — Proxmox write API token (optional; falls back to pve-token)
#   webhook-secret   — Webhook signing secret
#
# Override vault with env vars only for dev/debug:
# HP_ADMIN_SECRET=               # Override: admin auth (use vault instead)
# PVE_API_TOKEN=                 # Override: Proxmox read token (use vault instead)

# ── Daemon ──────────────────────────────────────────────────────────────
# HP_DAEMON_PORT is the Docker host port mapped to the container's fixed :8000.
# HP_PORT is the port the CLI dials the local daemon on (Settings.daemon_port).
HP_DAEMON_PORT=8000
# HP_PORT=8000

# ── Proxmox ─────────────────────────────────────────────────────────────
HP_PROXMOX_HOST=               # PVE hostname/IP (e.g. pve.example.local)
HP_PROXMOX_PORT=8006
HP_PROXMOX_VERIFY_SSL=false

# ── Provisioning defaults (optional; all EMPTY by default) ──────────────
# What guest provisioning uses when a request (or an invite) does not say it
# itself, so an invite stops carrying raw infra details. Empty/0 means "no
# default": the caller must name it, exactly as before these existed.
# Editable from Settings -> Subsystems -> Provisioning defaults, where each is
# checked against the live cluster before it is saved. Setting one HERE locks
# the UI field: the environment wins and the API refuses the write.
HP_PROVISION_DEFAULT_NODE=              # e.g. pve1
HP_PROVISION_DEFAULT_TEMPLATE_VMID=0    # 0 = unset; e.g. 9000
HP_PROVISION_DEFAULT_POOL=              # PVE resource pool guests join
HP_PROVISION_DEFAULT_STORAGE=           # empty = clones inherit the template's storage
HP_PROVISION_DEFAULT_BRIDGE=            # e.g. vmbr0; SET = provisioning writes net0
HP_PROVISION_DEFAULT_VLAN_TAG=0         # 0 = untagged; only applied with a bridge
HP_PROVISION_DEFAULT_IPCONFIG=ip=dhcp   # cloud-init ipconfig0
HP_PROVISION_TAILSCALE_INSTALL=1        # 1 = install tailscale in a guest that has none
HP_PROVISION_IP_MODE=static             # static = HomePilot allocates the address; dhcp = ip=dhcp
HP_PROVISION_DEFAULT_NAMESERVER=1.1.1.1 # resolver written into a statically-addressed guest

# ── The guest network (optional; NOT described by default) ───────────────
# The subnet a friend's machine lives on, and what it must never reach. Empty
# subnet/gateway means this instance describes no guest network: nothing is
# surveyed and provisioning writes no per-VM firewall rules. Set the bridge
# above to HP_GUEST_NETWORK_VNET to put provisioned guests on it and fence them.
# The network itself is BUILT by proposing a `guest-network` artifact and
# approving it - these settings are the desired state that artifact carries.
HP_GUEST_NETWORK_ZONE=guest             # SDN zone; 1-8 chars, PVE's limit
HP_GUEST_NETWORK_VNET=innkeep           # vnet guests attach to; 1-8 chars
HP_GUEST_NETWORK_SUBNET=                # e.g. 198.51.100.0/24; empty = no guest network
HP_GUEST_NETWORK_GATEWAY=               # e.g. 198.51.100.1; must be inside the subnet
HP_GUEST_NETWORK_SNAT=1                 # 1 = source-NAT guest traffic out of the node
HP_GUEST_NETWORK_DHCP=1                 # 1 = dnsmasq on the zone (needs dnsmasq on the node)
HP_GUEST_NETWORK_DHCP_RANGE=            # e.g. 198.51.100.100-198.51.100.199
HP_GUEST_NETWORK_DHCP_DNS_SERVER=       # empty = guests resolve at the gateway
HP_GUEST_NETWORK_ISOLATE_CIDRS=10.0.0.1/24  # THE FENCE; empty = no fence at all

# ── Embedding Service (optional; OFF by default) ────────────────────────
# Blank means no embedding service, and KB search runs keyword-only. It works -
# results are matched on words rather than meaning - and the startup self-check
# says so (Settings -> Optional subsystems).
# The LLM overlay sets the primary URL for you:
#   docker compose -f docker-compose.yml -f docker-compose.agent.yml --profile cpu up -d
# Set these by hand only to point at an embedding service you run elsewhere.
# Note that `localhost` here is the BACKEND CONTAINER, not the Docker host: reach
# an Ollama on the host as http://host.docker.internal:11434/api/embeddings.
HP_EMBEDDING_SERVICE_URL=       # e.g. http://llm-embed:8081/v1/embeddings (OpenAI-compatible)
HP_EMBEDDING_MODEL=bge-m3
HP_EMBEDDING_FALLBACK_URL=      # e.g. http://host.docker.internal:11434/api/embeddings (Ollama)
HP_EMBEDDING_FALLBACK_MODEL=nomic-embed-text

# ── MCP ─────────────────────────────────────────────────────────────────
HP_MCP_TOKEN=                  # Optional. Bearer token for MCP transport

# ── Events / Webhooks (optional; OFF by default) ────────────────────────
# Blank means events are recorded and shown in the UI but forwarded nowhere.
# n8n sits behind the `agents` compose profile, so on a default `docker compose
# up -d` there is no n8n to post to - and the webhook PATH is minted by the
# workflow you create, so it cannot be defaulted either. With the agents profile
# running, set this to the URL n8n shows for your workflow, e.g.
#   HP_EVENTS_WEBHOOK_URL=http://n8n:5678/webhook/artifact-proposed
HP_EVENTS_WEBHOOK_URL=
# HP_EVENTS_WEBHOOK_SECRET=    # Stored in vault as webhook-secret
HP_N8N_API_KEY=                # Optional. API key sent to the n8n instance

# ══════════════════════════════════════════════════════════════════════════
#  Agent Hub (TCP relay for managed hosts)
# ══════════════════════════════════════════════════════════════════════════
# On by default: host management is the product, and everything the hub needs
# (shared token, TLS certificate) generates itself on first boot. Set false to
# turn it off.
HP_AGENT_HUB_ENABLED=true
HP_AGENT_HUB_HOST=0.0.0.0
HP_AGENT_HUB_PORT=8443
# Address agents dial to reach the hub. Leave blank if you browse HomePilot by
# IP (the request host is used). Set to the HomePilot host IP (e.g.
# 10.0.0.1 or 10.0.0.1:8443) when HomePilot is behind a reverse proxy/domain,
# so the install command points agents at the raw hub port, not the proxy.
HP_AGENT_HUB_ADVERTISE_HOST=
# Leave blank to auto-generate on first boot (persisted to <data_dir>/.agent_hub_token,
# or read from the vault secret `agent-hub-token` when the vault is unlocked).
HP_AGENT_HUB_AUTH_TOKEN=          # Shared secret for agent auth
HP_AGENT_HUB_TLS=true
# Leave CERT/KEY blank to have the hub generate a self-signed pair on first boot
# in <data_dir>/hub/ (key 0600) and reuse it. Agents pin its sha256 fingerprint,
# which the UI and GET /agents/token hand out with the enrolment one-liner.
HP_AGENT_HUB_TLS_CERT=
HP_AGENT_HUB_TLS_KEY=
HP_AGENT_HUB_TLS_CA=              # Optional: CA to verify agent client certs (mutual TLS)
# HP_HUB_ALLOW_INSECURE=0        # Trusted isolated network only: allow plaintext non-loopback hub

# ══════════════════════════════════════════════════════════════════════════
#  Agent Services (n8n, SearXNG, Radicale, Whisper, Piper)
# ══════════════════════════════════════════════════════════════════════════
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=            # openssl rand -hex 32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

SEARXNG_SECRET_KEY=            # openssl rand -hex 32

# To create htpasswd: htpasswd -Bbc agent/radicale/htpasswd admin <password>
RADICALE_USER=admin
RADICALE_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
#  Timezone
# ══════════════════════════════════════════════════════════════════════════
TZ=Etc/UTC
