{
  "name": "HomePilot Artifact Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "homepilot-artifacts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "hp-artifact-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftExpression": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "signature-check",
              "left": "={{ $headers['x-webhook-signature'] }}",
              "right": "={{ $env.HP_WEBHOOK_SECRET ? (function(){const crypto=require('crypto');return crypto.createHmac('sha256',$env.HP_WEBHOOK_SECRET).update($body).digest('hex')})() : '' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-signature",
      "name": "Validate X-Webhook-Signature",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'invalid webhook signature' }) }}",
        "options": {
          "statusCode": 403
        }
      },
      "id": "reject-unauthorized",
      "name": "Reject Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_proposed"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_approved"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_rejected"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_applied"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_failed"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_superseded"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_revoked"
            },
            {
              "operation": "equals",
              "value1": "={{ $json.body.event }}",
              "value2": "artifact_drifted"
            }
          ]
        },
        "fallbackOutput": {
          "operation": "routeToOutput"
        }
      },
      "id": "route-by-event",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "content": "=🏠 **Artifact Proposed**\n\nID: `{{ $json.body.id }}`\nKind: `{{ $json.body.kind }}`\nIntent: {{ $json.body.intent }}\nTarget: {{ $json.body.target.kind }} / {{ $json.body.target.node }}:{{ $json.body.target.vmid }}\nStatus: `{{ $json.body.status }}`\nMutating: {{ $json.body.mutating }}\nTimestamp: {{ $json.body.timestamp }}\nSource: {{ $json.body.source.agent ?? 'unknown' }}"
      },
      "id": "format-proposed",
      "name": "Format Proposed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, -280]
