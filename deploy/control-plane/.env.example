# HomePilot v2 control-plane .env — copy to .env and fill in.
# Secrets (secret-key, admin-secret, webhook-secret) are created in the
# encrypted vault by `hp init` and do NOT belong here.

HP_DAEMON_PORT=8000

# ── Proxmox ────────────────────────────────────────────────────────────
HP_PROXMOX_HOST=10.0.0.1
HP_PROXMOX_PORT=8006
HP_PROXMOX_VERIFY_SSL=false
# user@realm!tokenid=uuid  (least-priv PVEAuditor token)
PVE_API_TOKEN=admin@pam!tokenid=REPLACE-ME
PVE_NODE_NAMES=pve

# ── Embeddings (hosted by the homepilot-agent stack) ───────────────────
HP_EMBEDDING_SERVICE_URL=http://host.docker.internal:11435/api/embeddings
HP_EMBEDDING_MODEL=nomic-embed-text

# ── Agent hub (managed-host agents connect here over TCP) ──────────────
HP_AGENT_HUB_ENABLED=true
HP_AGENT_HUB_HOST=0.0.0.0
HP_AGENT_HUB_PORT=8443
HP_AGENT_HUB_TLS=false
HP_AGENT_HUB_HEARTBEAT=30
# Shared enrollment secret — same value goes in each agent's systemd unit.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HP_AGENT_HUB_AUTH_TOKEN=REPLACE-ME

TZ=Etc/UTC
