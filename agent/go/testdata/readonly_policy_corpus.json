{
  "_doc": [
    "Shared corpus for the read-only policy (#682, #691). BOTH layers run it:",
    "agent/go/readonly_policy_test.go (the agent) and tests/test_readonly_policy.py",
    "(the adapter's exec_readonly and the MCP read_file_on_guest check).",
    "refuse_everywhere: refused by the MCP read tier AND by the agent in every mode, privileged included.",
    "refuse_read_tier: refused by the MCP read tier and the unprivileged agent (a privileged agent may run them for an admin).",
    "agent_only: the unprivileged agent runs them; the MCP read tier does not offer them.",
    "Add to this file whenever a new verb or path class is found: both layers pick it up."
  ],
  "commands": {
    "allow": [
      "hostname", "uptime", "uname -a", "free -m", "df -h", "df -h /",
      "ls", "ls -la /var/log", "ls /etc /var", "ls -lh /opt/homepilot",
      "ps", "ps aux", "ps auxf", "ps auxww", "ps -ef", "ps -e", "ps -eF", "ps -eo pid,comm,%cpu",
      "ps -p 1", "ps -u root", "ps --forest", "ps aux --sort=-%mem",
      "ip addr", "ip a", "ip addr show", "ip -4 addr show dev eth0", "ip link", "ip link show eth0",
      "ip route", "ip r", "ip route show table all", "ip route get 192.0.2.53", "ip neigh", "ip neigh show",
      "ip -s link", "ip -br addr", "ip -j route show", "ip rule list",
      "ss -tln", "ss -tlnp", "ss -s", "ss -tan state established", "ss -tn dst 192.0.2.1",
      "systemctl status nginx", "systemctl status nginx.service", "systemctl is-active nginx",
      "systemctl is-enabled nginx.service", "systemctl is-failed nginx", "systemctl status getty@tty1.service",
      "journalctl", "journalctl -u nginx", "journalctl -u nginx -n 50", "journalctl -xeu nginx",
      "journalctl --since=today --no-pager", "journalctl -b", "journalctl -b -1", "journalctl -n100",
      "journalctl -p err -b", "journalctl -S -1h", "journalctl -k", "journalctl -o json -n 20",
      "dpkg -l", "dpkg -l nginx", "dpkg -s nginx", "dpkg -S /usr/bin/ls", "dpkg -L nginx",
      "cat /etc/os-release", "cat /etc/hostname", "cat /var/log/syslog", "cat /proc/meminfo",
      "cat /etc/homepilot/some-artifact.conf", "cat /etc/systemd/system/foo.service",
      "cat /opt/homepilot/bootstrap.sh"
    ],
    "agent_only": ["docker ps", "docker images", "docker version"],
    "refuse_read_tier": [
      "systemctl daemon-reload", "systemctl restart nginx", "systemctl stop nginx",
      "systemctl enable nginx", "mkdir -p /opt/homepilot/x", "docker pull nginx"
