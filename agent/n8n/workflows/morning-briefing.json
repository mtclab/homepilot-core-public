{
  "name": "Morning Drift Briefing",
  "nodes": [
    {
      "id": "mb-schedule-0001",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "mb-query-inv-0002",
      "name": "Query Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 220],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HP_MCP_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HP_MCP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"query_inventory\",\"arguments\":{\"query\":\"all hosts drift status\"}},\"id\":1}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "mb-query-artifacts-0003",
      "name": "Query Pending Artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 380],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HP_MCP_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HP_MCP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"query_artifacts\",\"arguments\":{\"filter\":\"pending\"}},\"id\":2}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "mb-merge-0004",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [700, 300],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      }
    },
    {
      "id": "mb-format-0005",
      "name": "Format Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300],
      "parameters": {
        "jsCode": "const inventoryResult = $input.all()[0];\nconst artifactsResult = $input.all()[1];\n\nconst date = new Date().toLocaleDateString('en-GB', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'\n});\n\nlet inventoryText = 'No inventory data';\nlet artifactsText = 'No pending artifacts';\n\ntry {\n  const inv = inventoryResult.json;\n  if (inv && inv.result && inv.result.content) {\n    inventoryText = inv.result.content[0].text || JSON.stringify(inv.result.content);\n  } else if (inv && inv.error) {\n    inventoryText = 'HomePilot unreachable: ' + (inv.error.message || JSON.stringify(inv.error));\n  }\n} catch (e) {\n  inventoryText = 'Failed to parse inventory: ' + e.message;\n}\n\ntry {\n  const arts = artifactsResult.json;\n  if (arts && arts.result && arts.result.content) {\n    artifactsText = arts.result.content[0].text || JSON.stringify(arts.result.content);\n  } else if (arts && arts.error) {\n    artifactsText = 'HomePilot unreachable: ' + (arts.error.message || JSON.stringify(arts.error));\n  }\n} catch (e) {\n  artifactsText = 'Failed to parse artifacts: ' + e.message;\n}\n\nconst matrixMsg = `**Morning Briefing — ${date}**\n\n**Drift / Inventory**\n${inventoryText}\n\n**Pending Artifact Reviews**\n${artifactsText}`;\n\nconst telegramMsg = `Morning Briefing — ${date}\n\nDrift / Inventory:\n${inventoryText}\n\nPending Artifact Reviews:\n${artifactsText}`;\n\nreturn [{ json: { matrix_message: matrixMsg, telegram_message: telegramMsg } }];"
      }
    },
    {
      "id": "mb-matrix-0006",
      "name": "Send to Matrix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 220],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MATRIX_HOMESERVER }}/_matrix/client/v3/rooms/{{ encodeURIComponent($env.MATRIX_ROOM_ID) }}/send/m.room.message/{{ $now.toFormat('x') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MATRIX_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({msgtype: 'm.text', body: $json.matrix_message, format: 'org.matrix.custom.html', formatted_body: $json.matrix_message.replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>').replace(/\\n/g, '<br/>')}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      }
    },
    {
      "id": "mb-telegram-gate-0007",
      "name": "Telegram Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 420],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "mb-cond-tg",
              "leftValue": "={{ $env.TELEGRAM_BOT_TOKEN }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mb-telegram-0008",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1360, 380],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ALLOWED_USER_ID }}",
        "text": "={{ $('Format Briefing').item.json.telegram_message }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          { "node": "Query Inventory", "type": "main", "index": 0 },
          { "node": "Query Pending Artifacts", "type": "main", "index": 0 }
        ]
      ]
    },
    "Query Inventory": {
      "main": [
        [{ "node": "Merge Results", "type": "main", "index": 0 }]
      ]
    },
    "Query Pending Artifacts": {
      "main": [
        [{ "node": "Merge Results", "type": "main", "index": 1 }]
      ]
    },
    "Merge Results": {
      "main": [
        [{ "node": "Format Briefing", "type": "main", "index": 0 }]
      ]
    },
    "Format Briefing": {
      "main": [
        [
          { "node": "Send to Matrix", "type": "main", "index": 0 },
          { "node": "Telegram Enabled?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram Enabled?": {
      "main": [
        [{ "node": "Send to Telegram", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Etc/UTC"
  },
  "versionId": "mb000000-0000-0000-0000-000000000004",
  "id": "morning-briefing",
  "meta": {
    "instanceId": "CONFIGURE_ME"
  },
  "tags": [
    { "name": "notifications" }
  ],
  "pinData": {}
}
